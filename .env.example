# =====================================================
# CONFIGURACIÓN DEL PROYECTO LANGCHAIN - EJEMPLO
# =====================================================
# Copia este archivo como .env y agrega tus valores reales

# ===== Identidad del bot =====
# Nombre global del asistente (se usa en la API, logs y respuestas conversacionales).
APP_NAME=EVIA

# ===== API de Recursos Humanos =====
API_RH_URL=https://services.satechenergy.com/api/rh

# ===== Servidor API (desarrollo local) =====
API_PORT=8001

# ===== Paperless-ngx =====
PAPERLESS_URL=https://tu-servidor-paperless.com
PAPERLESS_TOKEN=tu_token_aqui

# ===== Ollama (Modelo de IA Local) =====
OLLAMA_URL=https://ollama.tech-energy.lat
OLLAMA_MODEL=phi4-mini:latest

# ===== Configuración de IA =====
# LOCALIA controla los EMBEDDINGS y la colección de ChromaDB.
# true = Ollama (local), false = OpenAI (cloud).
LOCALIA=true

# Proveedor del LLM de chat (etapa de respuesta del RAG):
#   auto     => deriva de LOCALIA (ollama si true, openai si false)
#   ollama   => Ollama local
#   openai   => OpenAI (requiere OPENAI_API_KEY)
#   opencode => Gateway de OpenCode Go (recomendado con LOCALIA=true para embeddings locales)
LLM_PROVIDER=auto

# ===== OpenCode Go (gateway compatible con OpenAI) =====
# Requerido solo si LLM_PROVIDER=opencode
OPENCODE_BASE_URL=
OPENCODE_API_KEY=
OPENCODE_MODEL=

# ===== OpenAI API =====
# Requerido si LOCALIA=false
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tu_clave_aqui
OPENAI_MODEL_RAPIDO=gpt-4o-mini
OPENAI_MODEL_RAZONAMIENTO=gpt-4o

# ===== ChromaDB =====
CHROMA_DB_PATH=./chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Indexar todos los documentos al arrancar la API. Por defecto false: la
# indexación se hace con `python scripts/indexar_docs.py` o el endpoint
# protegido /reindexar (evita que varios workers indexen en paralelo).
INDEX_ON_STARTUP=false

# ===== Base de Datos SQLite (Opcional) =====
DATABASE_PATH=data/empresa.db

# ===== Voz (STT + TTS local) =====
# Requiere: ffmpeg (sistema) + pip install faster-whisper piper-tts
VOICE_ENABLED=false
VOICE_BACKEND=simple            # simple | avanzado (qué bot RAG responde)
# STT (voz -> texto): local (faster-whisper) | openai (whisper-1)
STT_PROVIDER=local
WHISPER_MODEL=small             # tiny|base|small|medium|large-v3
WHISPER_DEVICE=cpu              # cpu | cuda
WHISPER_COMPUTE_TYPE=int8       # int8 (cpu) | float16 (gpu)
STT_LANGUAGE=es
VOICE_MAX_SECONDS=60
OPENAI_STT_MODEL=whisper-1      # whisper-1 | gpt-4o-transcribe (si STT_PROVIDER=openai)
# TTS (texto -> voz): local (Piper) | openai (tts-1)
TTS_PROVIDER=local
PIPER_VOICE_PATH=models/piper/es_MX.onnx
OPENAI_TTS_MODEL=tts-1          # tts-1 | tts-1-hd | gpt-4o-mini-tts (si TTS_PROVIDER=openai)
OPENAI_TTS_VOICE=nova           # nova/shimmer/coral = femeninas

# ===== Módulo de Consultas a Datos (NL -> SQL / API REST) =====
# Permite consultar orígenes (APIs REST y bases MySQL) de SOLO LECTURA a partir
# de lo que diga el usuario. Apagado por defecto. Ver config/rules.example.yaml.
CONSULTAS_ENABLED=false
RULES_PATH=config/rules.yaml
CONSULTAS_MAX_FILAS=500          # tope global de filas devueltas
CONSULTAS_SQL_TIMEOUT=8          # segundos máx. de ejecución por consulta SQL
CONSULTAS_REST_TIMEOUT=10        # segundos de timeout para orígenes REST

# Contexto semántico (RAG) de consultas: documentos en context/<origen>/*.md
# indexados con `python scripts/indexar_contexto.py`. Si la colección está
# vacía o ChromaDB no responde, las consultas degradan a solo rules.yaml.
CONSULTAS_RAG_ENABLED=true
CONSULTAS_RAG_TOP_K=3            # chunks inyectados al prompt NL->SQL
CONTEXT_PATH=context             # carpeta base del contexto por origen

# Orígenes SQL — usa SIEMPRE un usuario MySQL de SOLO LECTURA (GRANT SELECT).
# Dos formas de configurar la conexión (elige una por origen en rules.yaml):
#
#   A) Estilo Laravel (recomendado): el origen declara 'conexion_prefijo: DB' y aquí
#      defines las variables con ese prefijo (no requiere URL-encodear la contraseña).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cartera_clientes
DB_USERNAME=tu_usuario_readonly
DB_PASSWORD=tu_password
#
#   B) DSN completo (alternativa): el origen declara 'dsn_env: VENTAS_DB_URL'. Codifica
#      caracteres especiales de la contraseña (p.ej. '@' -> %40).
# VENTAS_DB_URL=mysql+pymysql://ro_bot:password@localhost:3306/ventas

# ===== Seguridad / Operación =====
# Token requerido (header X-Admin-Token) para operaciones administrativas
# como POST /reindexar. Si se deja vacío, esos endpoints quedan deshabilitados (403).
ADMIN_TOKEN=

# Orígenes permitidos para CORS. "*" para todos (sin credenciales) o lista
# separada por comas, p.ej.: https://tech-energy.lat,https://app.tech-energy.lat
CORS_ORIGINS=*
